rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // levels 컬렉션: 누구나 읽기 가능, 쓰기는 관리자만
    match /levels/{levelId} {
      allow read: if true;
      allow write: if request.auth != null 
        && request.auth.token.email in [
          'cjsdnwls7738@gmail.com'
        ];
    }
    
    // users 컬렉션: 관리자는 전체 읽기, 일반 유저는 본인만
    match /users/{userId} {
      allow read: if request.auth != null 
        && (request.auth.uid == userId 
            || request.auth.token.email in ['cjsdnwls7738@gmail.com']);
      allow write: if request.auth != null 
        && request.auth.uid == userId;
    }
    
    // deleted_users 컬렉션: 본인만 쓰기, 본인 또는 관리자만 읽기/삭제
    match /deleted_users/{userId} {
      allow create, update: if request.auth != null 
        && request.auth.uid == userId;
      allow read, delete: if request.auth != null 
        && (request.auth.uid == userId || request.auth.token.email == resource.data.email || request.auth.token.email in ['cjsdnwls7738@gmail.com']);
    }
    
    // 그 외 모든 문서: 접근 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
